[Unit]
Description=Kith Django API (Gunicorn)
After=network.target postgresql.service redis.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/djngopersonal_project/assignment
EnvironmentFile=-/var/www/djngopersonal_project/assignment/.env
ExecStart=/var/www/djngopersonal_project/venv/bin/gunicorn \
    --bind 127.0.0.1:8001 \
    --config /var/www/djngopersonal_project/deploy/gunicorn.conf.py \
    assignment.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
